.wrap {
  padding: 20rpx 24rpx 80rpx;
}

.loading, .err {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a80;
}
.err { color: #b4392f; }

/* ===== 列表态 ===== */
.hd {
  margin-bottom: 8rpx;
}
.hd-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #23231f;
}
.hd-sub {
  font-size: 24rpx;
  color: #8a8a80;
  margin-left: 12rpx;
}
.chips {
  margin-top: 16rpx;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.chip {
  display: inline-block;
  min-width: 68rpx;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #5a5a52;
  background: #ffffff;
  border: 1rpx solid #e6e4da;
  border-radius: 999rpx;
}
.chip.on {
  color: #ffffff;
  background: #2f6f4f;
  border-color: #2f6f4f;
  font-weight: 600;
}

.vlist {
  display: flex;
  flex-direction: column;
}
.vitem {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e6e4da;
  border-radius: 14rpx;
}
.vitem-press { background: #eef4f0; }
.vplay {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  margin-right: 18rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: #2f6f4f;
  border-radius: 50%;
}
.vname {
  flex: 1;
  font-size: 27rpx;
  color: #23231f;
  line-height: 1.4;
  word-break: break-all;
}
.vempty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a80;
}

/* ===== 详情态 ===== */
.vtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #23231f;
  margin-bottom: 14rpx;
  line-height: 1.4;
  word-break: break-all;
}
.player {
  width: 100%;
  height: 420rpx;
  background: #000;
  border-radius: 12rpx;
}
.note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8a80;
  line-height: 1.5;
}

.cues {
  margin-top: 18rpx;
  max-height: 52vh;
  border: 1rpx solid #e6e4da;
  border-radius: 12rpx;
  background: #ffffff;
  padding: 6rpx 0;
}
.cue {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0efe8;
}
.cue:last-child { border-bottom: none; }
.cue.on {
  background: #eef4f0;
}
.cue-idx {
  flex: 0 0 auto;
  width: 44rpx;
  font-size: 22rpx;
  color: #b0aea4;
  padding-top: 2rpx;
}
.cue.on .cue-idx { color: #2f6f4f; font-weight: 700; }
.cue-txt {
  flex: 1;
  font-size: 28rpx;
  color: #23231f;
  line-height: 1.6;
}
.cue.on .cue-txt { color: #2f6f4f; font-weight: 600; }
.cue-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a80;
}

.backbar {
  margin-top: 24rpx;
  text-align: center;
}
.backbtn {
  display: inline-block;
  padding: 16rpx 40rpx;
  font-size: 27rpx;
  color: #2f6f4f;
  background: #ffffff;
  border: 1rpx solid #2f6f4f;
  border-radius: 999rpx;
}
