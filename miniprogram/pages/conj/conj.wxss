.wrap {
  padding: 20rpx 24rpx 160rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: #8a8a86;
  margin-bottom: 12rpx;
}

.link {
  margin-left: auto;
  color: #2f6f4f;
}

.item {
  margin-bottom: 18rpx;
}

.item.right {
  border-left: 6rpx solid #1d9e75;
}

.item.wrong {
  border-left: 6rpx solid #e24b4a;
}

.q {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.num {
  font-size: 24rpx;
  color: #b4b2a9;
  min-width: 40rpx;
}

.def {
  font-size: 32rpx;
  font-weight: 500;
}

.pos {
  font-size: 22rpx;
  color: #8a8a86;
  background: #f1efe8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8a86;
}

.note {
  display: block;
  margin-top: 4rpx;
}

.answer {
  /* 同 practice/sentences：宽度高度都显式给，别依赖原生控件默认值 */
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  font-size: 30rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.unknown {
  color: #8a8a86;
  border: 1rpx solid #d3d1c7;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.unknown.on {
  color: #a32d2d;
  border-color: #e24b4a;
  background: #fcebeb;
}

.flag {
  margin-left: auto;
  font-weight: 500;
}

.reveal {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #0f6e56;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeede9;
}

/* 底部按钮条：app.wxss 的 .btn 带 margin-top，在 flex 里会被顶歪 */
.bar .btn {
  flex: 1;
  margin-top: 0;
  font-size: 30rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #a0a09a;
  line-height: 1.6;
}

.empty,
.err {
  padding: 40rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a86;
}

.err {
  color: #a32d2d;
}

.tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.tab {
  font-size: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #f1efe8;
  color: #5f5e5a;
}

.tab.on {
  background: #2f6f4f;
  color: #ffffff;
}

/* 动词活用速查表（て形・ます形・ない形 三表合并） */
.grammar {
  background: #ffffff;
  border: 1rpx solid #eeede9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.g-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #2f6f4f;
}

.g-title {
  font-size: 27rpx;
  color: #ffffff;
  font-weight: 500;
}

.g-arrow {
  font-size: 23rpx;
  color: #cfe3d8;
}

.g-body {
  padding: 14rpx;
}

.g-table {
  border: 1rpx solid #d8d6cc;
  border-radius: 8rpx;
  overflow: hidden;
}

.g-tr {
  display: flex;
  align-items: stretch;
}

.g-tr + .g-tr {
  border-top: 1rpx solid #e6e4da;
}

.g-tr text {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 10rpx 4rpx;
  font-size: 22rpx;
  line-height: 1.35;
  border-left: 1rpx solid #e6e4da;
  word-break: break-all;
}

.g-tr text:first-child {
  border-left: none;
}

.g-trh text {
  background: #eef4e9;
  font-weight: 500;
  color: #3d6b52;
}

/* 词类列：深绿底白字，跨行连成一条（延续行不写字，靠同色底拼起来） */
.c0 {
  width: 100rpx;
  background: #2f6f4f;
  color: #ffffff;
}

/* 基本形（词尾分组）列 */
.c1 {
  width: 148rpx;
  background: #f6f8f2;
}

.c2 {
  flex: 1;
  min-width: 0;
}

/* 上行规则的延续格：去掉左边框、藏文字，视觉上与上行合成一格 */
.cont {
  border-left: none;
  color: transparent;
}

.g-notes {
  margin-top: 14rpx;
}

.g-note {
  display: block;
  font-size: 23rpx;
  color: #5f5e5a;
  line-height: 1.7;
}

.word {
  font-size: 32rpx;
  font-weight: 500;
}

.task {
  margin-top: 16rpx;
}

.label {
  font-size: 26rpx;
  color: #5f5e5a;
}

.answer.small {
  font-size: 28rpx;
  padding: 10rpx 14rpx;
}

.mark {
  margin-left: 12rpx;
  font-size: 28rpx;
}

.expect {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #0f6e56;
}
