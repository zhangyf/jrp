.wrap {
  padding: 24rpx 24rpx 40rpx;
}

.status .title {
  font-size: 40rpx;
  font-weight: 500;
}

.status .sub {
  font-size: 26rpx;
  color: #8a8a86;
  margin-top: 6rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.tag.ok {
  background: #e1f5ee;
  color: #0f6e56;
}

.tag.wait {
  background: #faeeda;
  color: #854f0b;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 500;
}

.entry-desc {
  font-size: 25rpx;
  color: #8a8a86;
  margin-top: 6rpx;
}

.arrow {
  font-size: 40rpx;
  color: #c8c8c4;
}

.err {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #a32d2d;
}
