.wrap {
  padding: 24rpx 24rpx 40rpx;
}

/* 自定义导航栏：浅底，logo 与登录徽章同一行 */
.nav {
  background: #f7f7f5;
  border-bottom: 1rpx solid #e6e4da;
}

.nav-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
}

/* logo：透明底 PNG，比例约 1.05，宽 88 → 高 84 */
.nav-logo {
  width: 88rpx;
  height: 84rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

/* 双列色块入口：width:49% + space-between（calc() 在部分机型 WebView 会退化成单列）。
   导航行下方留出呼吸空间，别让色块贴着 logo。 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 28rpx;
}

.tile {
  width: 49%;
  height: 170rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

.tile-title {
  font-size: 34rpx;
  font-weight: 600;
}

.tile-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* 按下反馈：轻微压暗，让「能点」更明显 */
.tile-press {
  opacity: 0.82;
}

/* 每个版块一个颜色：绿=日常主打的列表复习，蓝=造句，砖红=钉子户（错词），紫=活用 */
.t-words {
  background: #2f6f4f;
}

.t-sentences {
  background: #2f6fa8;
}

.t-hard {
  background: #b4543c;
}

.t-conj {
  background: #7a5aa0;
}

.err {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  color: #a32d2d;
}
