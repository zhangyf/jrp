<view class="wrap">
  <!-- 自定义导航栏：原生导航栏放不了图片，logo 画在这里（浅底，logo 才看得清） -->
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-row" style="height:{{navH}}px">
      <image class="nav-logo" src="/images/logo.png" mode="aspectFit" />
      <text class="nav-title">每日练习</text>
    </view>
  </view>
  <view class="err" wx:if="{{message}}">{{message}}</view>

  <!-- 体验版：五个版块都能进，只是题量少、数据是假的、进度不保存。
       退出过的人也落在这里 —— 试用态就是默认态，没有「已退出」的门。 -->
  <block wx:if="{{trial}}">
    <view class="trial-note">体验版 · 题目固定 · 进度不保存</view>
    <view class="grid">
      <view class="tile t-words" data-mode="words" bindtap="go" hover-class="tile-press">
        <view class="tile-title">每日复习</view>
        <view class="tile-desc">5 个词</view>
      </view>
      <view class="tile t-sentences" data-mode="sentences" bindtap="go" hover-class="tile-press">
        <view class="tile-title">造句</view>
        <view class="tile-desc">3 句</view>
      </view>
      <view class="tile t-hard" data-mode="hard" bindtap="go" hover-class="tile-press">
        <view class="tile-title">钉子户</view>
        <view class="tile-desc">5 个词</view>
      </view>
      <view class="tile t-conj" data-mode="conj" bindtap="go" hover-class="tile-press">
        <view class="tile-title">活用练习</view>
        <view class="tile-desc">2 题</view>
      </view>
      <view class="tile t-lex" data-mode="lexicon" bindtap="go" hover-class="tile-press">
        <view class="tile-title">词汇总表</view>
        <view class="tile-desc">10 个词</view>
      </view>
      <!-- 知识点是查不是练；体验版也能进，只是每课只看得到开头一部分（页面里盖模糊） -->
      <view class="tile t-kno" data-mode="knowledge" bindtap="go" hover-class="tile-press">
        <view class="tile-title">知识点</view>
        <view class="tile-desc">每课只看一部分</view>
      </view>
    </view>
    <view class="foot-link" bindtap="onWxLogin">{{busy ? '登录中…' : '微信登录后可保存进度'}}</view>
  </block>

  <!-- 双列色块入口：每个版块一个颜色，一眼看出能点（width:49% + space-between，
       别用 flex-basis calc() —— 部分机型 WebView 不认）。 -->
  <block wx:else>
  <!-- 已登录但还没被批准：权限跟正式用户一样（7 个自然日），只摆一句倒计时 -->
  <view class="trial-note" wx:if="{{pending}}">
    还没审核通过 · 还可体验 {{daysLeft}} 天，到期需管理员批准
  </view>
  <view class="grid">
    <view class="tile t-words" data-mode="words" bindtap="go" hover-class="tile-press">
      <view class="tile-title">列表复习</view>
      <view class="tile-desc">今天该复习的词</view>
    </view>
    <view class="tile t-sentences" data-mode="sentences" bindtap="go" hover-class="tile-press">
      <view class="tile-title">造句</view>
      <view class="tile-desc">看中文写整句</view>
    </view>
    <view class="tile t-hard" data-mode="hard" bindtap="go" hover-class="tile-press">
      <view class="tile-title">钉子户</view>
      <view class="tile-desc">反复出错的词</view>
    </view>
    <view class="tile t-conj" data-mode="conj" bindtap="go" hover-class="tile-press">
      <view class="tile-title">活用练习</view>
      <view class="tile-desc">变形 · 只练不计档</view>
    </view>
    <!-- 词汇总表是查不是练，用中性色跟上面四个练习色块区分开；尺寸沿用 .tile。
         录入新词不在这里 —— 它是工具，跟练习/统计一起放在底部导航。 -->
    <view class="tile t-lex" data-mode="lexicon" bindtap="go" hover-class="tile-press">
      <view class="tile-title">词汇总表</view>
      <view class="tile-desc">查词 · 看掌握情况</view>
    </view>
    <!-- 新标日III知识点：按课看知识点总结（2026-11-03）。未登录每课只看开头一部分 -->
    <view class="tile t-kno" data-mode="knowledge" bindtap="go" hover-class="tile-press">
      <view class="tile-title">知识点</view>
      <view class="tile-desc">新标日III · 按课查</view>
    </view>
  </view>

  <view class="foot-link" bindtap="onExit">退出登录</view>
  </block>
</view>
