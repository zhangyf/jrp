<view class="wrap">
  <!-- 自定义导航栏：原生导航栏放不了图片，logo 画在这里（浅底，logo 才看得清） -->
  <view class="nav" style="padding-top:{{statusBarH}}px">
    <view class="nav-row" style="height:{{navH}}px">
      <image class="nav-logo" src="/images/logo.png" mode="aspectFit" />
      <text class="nav-title">每日练习</text>
    </view>
  </view>
  <view class="err" wx:if="{{message}}">{{message}}</view>

  <!-- 双列色块入口：每个版块一个颜色，一眼看出能点（width:49% + space-between，
       别用 flex-basis calc() —— 部分机型 WebView 不认）。 -->
  <view class="grid">
    <view class="tile t-words" data-mode="words" bindtap="go" hover-class="tile-press">
      <view class="tile-title">列表复习</view>
      <view class="tile-desc">今天该复习的词</view>
    </view>
    <view class="tile t-sentences" data-mode="sentences" bindtap="go" hover-class="tile-press">
      <view class="tile-title">造句</view>
      <view class="tile-desc">看中文写整句</view>
    </view>
    <view class="tile t-hard" data-mode="hard" bindtap="go" hover-class="tile-press">
      <view class="tile-title">钉子户</view>
      <view class="tile-desc">反复出错的词</view>
    </view>
    <view class="tile t-conj" data-mode="conj" bindtap="go" hover-class="tile-press">
      <view class="tile-title">活用练习</view>
      <view class="tile-desc">变形 · 只练不计档</view>
    </view>
  </view>
</view>
