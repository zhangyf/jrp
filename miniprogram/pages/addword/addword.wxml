<view class="wrap">
  <view class="result" wx:if="{{result}}">
    <view class="r-title">录好了</view>
    <view class="r-line">新增 <text class="n">{{result.added}}</text> 词<text wx:if="{{result.duplicates}}">，跳过重复 {{result.duplicates}} 个</text></view>
    <view class="r-line" wx:if="{{result.version}}">档案 {{result.version}} · 共 {{result.total}} 词</view>
    <view class="r-warn" wx:if="{{result.dupDefs.length}}">
      <view class="w-t">释义撞车（建议加括号区分）：</view>
      <view class="w-i" wx:for="{{result.dupDefs}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="r-warn" wx:if="{{result.dupCores.length}}">
      <view class="w-t">主释义相同（建议补区分点）：</view>
      <view class="w-i" wx:for="{{result.dupCores}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="btn" bindtap="again">继续录</view>
  </view>

  <block wx:else>
    <view class="sec">
      <view class="sec-title">手打录入</view>
      <input class="ipt" placeholder="词形，如 みず(水)" value="{{word}}" bindinput="onWord" />
      <view class="btn sm" bindtap="addManual">{{looking ? '查中文中…' : '加入待录列表'}}</view>
      <view class="note">中文意思不用填，服务端自己查（先查词库，查不到再问模型）。</view>
    </view>

    <view class="sec">
      <view class="sec-title">拍照 / 相册取词</view>
      <view class="btn ghost" bindtap="pickImages">{{ocrBusy ? '识别中…' : '选图片（可多张）'}}</view>
      <view class="note" wx:if="{{ocrNote}}">{{ocrNote}}</view>
      <view class="note" wx:else>拍课本的生词表最准：一行一个词，认出来后自己勾。</view>
    </view>

    <view class="sec" wx:if="{{shots.length}}">
      <view class="sec-row">
        <view class="sec-title">认出 {{candCount}} 个候选</view>
        <view class="mini" bindtap="toggleAll">全选/全不选</view>
      </view>

      <!-- 按图片分块：每块带原图缩略图，老师对着照片核哪个词认错了 -->
      <view class="shot" wx:for="{{shots}}" wx:for-item="sh" wx:for-index="si" wx:key="path">
        <view class="sh-top">
          <image class="sh-img" src="{{sh.path}}" mode="aspectFill"
                 data-src="{{sh.path}}" bindtap="previewShot" />
          <view class="sh-side">
            <view class="sh-no">第 {{si + 1}} 张</view>
            <view class="sh-cnt" wx:if="{{sh.ok}}">认出 {{sh.words.length}} 个 · 点图看大图</view>
            <view class="sh-err" wx:else>{{sh.error}}</view>
            <view class="sh-retry" wx:if="{{!sh.ok}}" data-index="{{si}}" bindtap="retryShot">重认这张</view>
          </view>
        </view>

        <view class="cand {{item.checked ? 'on' : ''}}"
              wx:for="{{sh.words}}" wx:for-item="item" wx:for-index="wi" wx:key="word">
          <view class="c-head" data-si="{{si}}" data-wi="{{wi}}" bindtap="toggleCand">
            <view class="box">{{item.checked ? '✓' : ''}}</view>
            <view class="c-w">{{item.word || '（空）'}}</view>
            <view class="c-d">{{item.def || '缺中文'}}</view>
          </view>
          <view class="c-edit">
            <input class="ipt sm" value="{{item.word}}" data-si="{{si}}" data-wi="{{wi}}" data-field="word" bindinput="editCand" placeholder="词形" />
            <input class="ipt sm" value="{{item.def}}" data-si="{{si}}" data-wi="{{wi}}" data-field="def" bindinput="editCand" placeholder="中文意思" />
          </view>
        </view>
        <view class="sh-empty" wx:if="{{sh.ok && sh.words.length == 0}}">这张没认出词条</view>
      </view>

      <view class="row-btn">
        <view class="btn sm" bindtap="addSelected">{{looking ? '补中文中…' : '把勾上的加入待录'}}</view>
        <view class="btn sm ghost" bindtap="clearCands">不要了</view>
      </view>
    </view>

    <view class="sec" wx:if="{{pending.length}}">
      <view class="sec-title">待录 {{pending.length}} 个</view>
      <view class="pend" wx:for="{{pending}}" wx:key="word">
        <view class="p-l">
          <view class="p-w">{{item.word}}</view>
          <input class="ipt tiny" wx:if="{{item.editing}}"
                 placeholder="补中文意思" value="{{item.def}}"
                 data-index="{{index}}" bindinput="editDef" />
          <view class="p-d" wx:else>{{item.def || '（还没中文）'}}</view>
        </view>
        <view class="p-e" data-index="{{index}}" bindtap="toggleEdit">{{item.editing ? '好了' : '改'}}</view>
        <view class="p-x" data-index="{{index}}" bindtap="removePending">×</view>
      </view>
      <view class="btn" bindtap="submit">{{saving ? '正在写入…' : '录进档案'}}</view>
    </view>
  </block>
</view>
