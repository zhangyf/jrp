<view class="wrap">
  <view class="brand">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />
    <view class="title">jrp 日语复习</view>
    <view class="sub">按艾宾浩斯曲线安排每天的复习</view>
  </view>

  <view class="checking" wx:if="{{checking}}">正在登录…</view>

  <block wx:else>
    <view class="acts">
      <view class="btn main" bindtap="onWxLogin">{{busy ? '登录中…' : '微信登录'}}</view>
      <view class="btn ghost" bindtap="onTrial">{{busy ? '进入中…' : '试用账号'}}</view>
    </view>

    <view class="note">先随便逛，五个版块都能看；点「微信登录」才开始记录进度。</view>
  </block>

  <view class="err" wx:if="{{message}}">{{message}}</view>
</view>
