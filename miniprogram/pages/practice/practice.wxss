.wrap {
  padding: 20rpx 24rpx 160rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: #8a8a86;
  margin-bottom: 12rpx;
}

.link {
  margin-left: auto;
  color: #2f6f4f;
}

.item {
  margin-bottom: 18rpx;
}

.item.right {
  border-left: 6rpx solid #1d9e75;
}

.item.wrong {
  border-left: 6rpx solid #e24b4a;
}

.q {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.num {
  font-size: 24rpx;
  color: #b4b2a9;
  min-width: 40rpx;
}

.def {
  font-size: 32rpx;
  font-weight: 500;
  /* 释义长时自己收缩，别把右上角的「不会」挤出卡片 */
  flex: 1 1 auto;
  min-width: 0;
}

/* 题干行右侧一组：判分标记 + 「不会」胶囊 */
.q-right {
  margin-left: auto;
  align-self: center; /* .q 是 baseline 对齐，这组要自己居中，不然会被释义的基线顶偏 */
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.mark {
  font-size: 32rpx;
  font-weight: 600;
}

.mark.right {
  color: #1d9e75;
}

.mark.wrong {
  color: #e24b4a;
}

.pos {
  font-size: 22rpx;
  color: #8a8a86;
  background: #f1efe8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8a86;
}

.note {
  display: block;
  margin-top: 4rpx;
}

.answer {
  margin-top: 14rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  font-size: 30rpx;
}

.unknown {
  font-size: 26rpx;
  color: #8a8a86;
  border: 1rpx solid #d3d1c7;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  white-space: nowrap; /* 胶囊按钮禁止折行，保险 */
}

.unknown.on {
  color: #a32d2d;
  border-color: #e24b4a;
  background: #fcebeb;
}

.reveal {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #0f6e56;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeede9;
}

/* 底部按钮条：app.wxss 的 .btn 带 margin-top，在 flex 里会被顶歪 */
.bar .btn {
  flex: 1;
  margin-top: 0;
  font-size: 30rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #a0a09a;
  line-height: 1.6;
}

.empty,
.err {
  padding: 40rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a86;
}

.err {
  color: #a32d2d;
}
