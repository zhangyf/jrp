.wrap {
  padding: 20rpx 24rpx 160rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: #8a8a86;
  margin-bottom: 12rpx;
}

.link {
  margin-left: auto;
  color: #2f6f4f;
}

.item {
  margin-bottom: 18rpx;
}

.item.right {
  border-left: 6rpx solid #1d9e75;
}

.item.wrong {
  border-left: 6rpx solid #e24b4a;
}

.q {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.num {
  font-size: 24rpx;
  color: #b4b2a9;
  min-width: 40rpx;
}

.def {
  font-size: 32rpx;
  font-weight: 500;
  /* 释义长时自己收缩，别把右上角的「不会」挤出卡片 */
  flex: 1 1 auto;
  min-width: 0;
}

/* 题干行右侧一组：判分标记 + 「不会」胶囊 */
.q-right {
  margin-left: auto;
  align-self: center; /* .q 是 baseline 对齐，这组要自己居中，不然会被释义的基线顶偏 */
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.mark {
  font-size: 32rpx;
  font-weight: 600;
}

.mark.right {
  color: #1d9e75;
}

.mark.wrong {
  color: #e24b4a;
}

.pos {
  font-size: 22rpx;
  color: #8a8a86;
  background: #f1efe8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8a86;
}

.note {
  display: block;
  margin-top: 4rpx;
}

.answer {
  /* ⚠️ 小程序 input/textarea 的默认宽度不是 100%：不加 width 会从白格里伸出去。
     box-sizing 让边框和内边距算进 100% 里，不然照样超 2 个内边距的宽度。
     ⚠️ 高度也必须显式给：input 复用重建（比如回看态切巩固轮）时，
     不给 height 会被原生组件压成一条窄缝，placeholder 都显示不全。 */
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  font-size: 30rpx;
}

/* 回看态：只读的「你写的」一行 */
.ro-answer {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #eeede9;
  border-radius: 8rpx;
  background: #fafaf7;
  font-size: 30rpx;
}

.ro-answer.muted {
  color: #a0a09a;
}

.unk-line {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #a35a00;
}

.note-ok {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #2f6f4f;
}

/* 回看态的错词巩固条：暖色底，跟「不会」胶囊一个色系，扫一眼能看到 */
.requeue {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  background: #fff8ec;
  border: 1rpx solid #f0d9a8;
  border-radius: 12rpx;
}

.rq-text {
  flex: 1;
  font-size: 26rpx;
  color: #a35a00;
}

/* .btn 带 margin-top，在这条横排里会被顶歪 */
.rq-btn {
  flex: none;
  margin-top: 0;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 2;
}

/* 「不会」胶囊：默认就是暖色（琥珀底 + 深琥珀字），不能做成灰的 ——
   老师在输入框下面那版里根本没看见它。标了之后变红底白字，一眼能扫出来。 */
.unknown {
  font-size: 26rpx;
  font-weight: 500;
  color: #a35a00;
  background: #fff4e2;
  border: 1rpx solid #f0b357;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  white-space: nowrap; /* 胶囊按钮禁止折行，保险 */
}

.unknown.on {
  color: #ffffff;
  background: #e24b4a;
  border-color: #e24b4a;
}

.reveal {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #0f6e56;
}

/* 判错行的结果条：正确答案 + 「算对」胶囊（跟「不会」一个尺寸、一样显眼） */
.result-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.result-row .reveal {
  flex: 1 1 auto;
  min-width: 0;
  margin-top: 0;
}

.pick {
  flex: none;
  font-size: 26rpx;
  font-weight: 500;
  color: #2f6f4f;
  background: #ffffff;
  border: 1rpx solid #2f6f4f;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  white-space: nowrap;
}

.pick.on {
  color: #ffffff;
  background: #2f6f4f;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeede9;
}

/* 底部按钮条：app.wxss 的 .btn 带 margin-top，在 flex 里会被顶歪 */
.bar .btn {
  flex: 1;
  margin-top: 0;
  font-size: 30rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #a0a09a;
  line-height: 1.6;
}

.empty,
.err {
  padding: 40rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a86;
}

.err {
  color: #a32d2d;
}
