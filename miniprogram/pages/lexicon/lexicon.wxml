<view class="wrap">
  <view class="loading" wx:if="{{loading}}">正在加载词库…</view>
  <view class="err" wx:if="{{err}}">{{err}}</view>

  <block wx:if="{{!loading && !err}}">
    <view class="tools">
      <input class="search"
             placeholder="搜假名 / 汉字 / 中文"
             value="{{q}}"
             bindinput="onSearch" />
      <view class="picks">
        <picker mode="selector" range="{{posList}}" value="{{posIndex}}" bindchange="onPickPos">
          <view class="pick {{posIndex > 0 ? 'on' : ''}}">{{posList[posIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{statusList}}" value="{{statusIndex}}" bindchange="onPickStatus">
          <view class="pick {{statusIndex > 0 ? 'on' : ''}}">{{statusList[statusIndex]}}</view>
        </picker>
        <picker mode="selector" range="{{groupList}}" value="{{groupIndex}}" bindchange="onPickGroup">
          <view class="pick {{groupIndex > 0 ? 'on' : ''}}">{{groupList[groupIndex]}}</view>
        </picker>
      </view>
      <view class="count">
        共 {{total}} 词，筛出 <text class="n">{{filtered}}</text> 个
        <text class="reset" bindtap="resetFilter">重置</text>
      </view>
    </view>

    <view class="list" wx:if="{{view.length}}">
      <view class="row {{openIdx === index ? 'open' : ''}}"
            wx:for="{{view}}" wx:key="number"
            data-index="{{index}}" bindtap="toggle">
        <view class="rline">
          <view class="dot {{item.stCls}}"></view>
          <view class="word">
            <text class="kana">{{item.kana}}</text>
            <text class="kanji" wx:if="{{item.kanji}}">（{{item.kanji}}）</text>
          </view>
          <view class="pos" wx:if="{{item.pos}}">{{item.pos}}<text class="sub" wx:if="{{item.sub}}">·{{item.sub}}</text></view>
        </view>
        <view class="rline2">
          <text class="def">{{item.def}}</text>
          <text class="nt" wx:if="{{item.note}}">（{{item.note}}）</text>
          <text class="st {{item.stCls}}" wx:if="{{item.stText !== '—'}}">{{item.stText}}</text>
        </view>

        <view class="detail" wx:if="{{openIdx === index}}">
          <view class="dl">
            <text>复习</text><text>{{item.reviews}} 次</text>
          </view>
          <view class="dl">
            <text>答错</text><text>{{item.errors}} 次</text>
          </view>
          <view class="dl">
            <text>正确率</text><text>{{item.reviews ? item.rate + '%' : '—'}}</text>
          </view>
          <view class="dl">
            <text>最近复习</text><text>{{item.last || '—'}}</text>
          </view>
          <view class="dl" wx:if="{{item.group}}">
            <text>课</text><text>{{item.group}}</text>
          </view>
          <view class="dnote" wx:if="{{item.wordNote}}">备注：{{item.wordNote}}</view>
        </view>
      </view>

      <view class="more" wx:if="{{shown < filtered}}">上拉加载更多…</view>
      <view class="more end" wx:else>已经到底了</view>
    </view>

    <view class="empty" wx:else>没有符合条件的词。</view>
  </block>
</view>
