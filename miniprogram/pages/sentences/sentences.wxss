.wrap {
  padding: 20rpx 24rpx 160rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: #8a8a86;
  margin-bottom: 12rpx;
}

.link {
  margin-left: auto;
  color: #2f6f4f;
}

.item {
  margin-bottom: 18rpx;
}

.item.right {
  border-left: 6rpx solid #1d9e75;
}

.item.wrong {
  border-left: 6rpx solid #e24b4a;
}

.q {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.num {
  font-size: 24rpx;
  color: #b4b2a9;
  min-width: 40rpx;
}

.def {
  font-size: 32rpx;
  font-weight: 500;
}

.pos {
  font-size: 22rpx;
  color: #8a8a86;
  background: #f1efe8;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8a86;
}

.note {
  display: block;
  margin-top: 4rpx;
}

.cn {
  font-size: 30rpx;
  font-weight: 500;
}

.reason {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8a8a86;
  line-height: 1.6;
}

/* 底部按钮条：app.wxss 的 .btn 带 margin-top，在 flex 里会被顶歪 */
.bar .btn {
  flex: 1;
  margin-top: 0;
  font-size: 30rpx;
}

.answer {
  /* ⚠️ textarea 默认宽度是固定 300px（input 才是 100%）—— 窄屏上会伸出白格。
     显式给 width + height：auto-height 首帧按默认尺寸渲染、几秒后才量好，
     就是老师看到的「刚进去特别宽」。固定高度没有首帧跳变。 */
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  font-size: 30rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.unknown {
  color: #8a8a86;
  border: 1rpx solid #d3d1c7;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

.unknown.on {
  color: #a32d2d;
  border-color: #e24b4a;
  background: #fcebeb;
}

.flag {
  margin-left: auto;
  font-weight: 500;
}

.reveal {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #0f6e56;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeede9;
}

.tip {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #a0a09a;
  line-height: 1.6;
}

.empty,
.err {
  padding: 40rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a8a86;
}

.err {
  color: #a32d2d;
}

/* 语法知识卡（助词用法 + 词语修饰，与活用页速查表同套路）：
   头条用造句的蓝色，跟首页色块和活用页的绿区分开 */
.grammar {
  background: #ffffff;
  border: 1rpx solid #eeede9;
  border-radius: 12rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.g-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #2f6fa8;
}

.g-title {
  font-size: 27rpx;
  color: #ffffff;
  font-weight: 500;
}

.g-arrow {
  font-size: 23rpx;
  color: #d3e5f2;
}

.g-body {
  padding: 16rpx 16rpx 20rpx;
}

.g-sec {
  font-size: 26rpx;
  font-weight: 500;
  color: #2f6fa8;
  margin: 18rpx 4rpx 12rpx;
}

.g-sec:first-child {
  margin-top: 2rpx;
}

/* ① 助词：左侧助词竖条 + 右侧用法一行 + 例句逐行 */
.p-row {
  display: flex;
  border: 1rpx solid #d8d6cc;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.p-word {
  width: 96rpx;
  background: #2f6fa8;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx 4rpx;
  word-break: break-all;
}

.p-main {
  flex: 1;
  min-width: 0;
  padding: 12rpx 16rpx;
}

.p-uses {
  display: block;
  font-size: 24rpx;
  color: #3f3e3a;
  line-height: 1.5;
  padding-bottom: 8rpx;
  border-bottom: 1rpx dashed #e6e4da;
  margin-bottom: 8rpx;
}

.p-ex {
  display: block;
  font-size: 23rpx;
  color: #8a8a86;
  line-height: 1.6;
}

/* ② 修饰表：三列 flex（延续格去左边框藏文字，模拟原表 rowspan） */
.m-tr {
  display: flex;
  border: 1rpx solid #d8d6cc;
  border-top: none;
}

.m-tr:first-of-type,
.m-th {
  border-top: 1rpx solid #d8d6cc;
}

.m-tr:first-of-type {
  border-top-right-radius: 8rpx;
  border-top-left-radius: 8rpx;
}

.m-tr:last-child {
  border-bottom-right-radius: 8rpx;
  border-bottom-left-radius: 8rpx;
}

.m-tr text {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 10rpx 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  border-left: 1rpx solid #e6e4da;
  word-break: break-all;
}

.m-tr text:first-child {
  border-left: none;
}

.m-th text {
  background: #eaf2f9;
  font-weight: 500;
  color: #2a5a86;
}

.m-c0 {
  width: 96rpx;
  background: #2f6fa8;
  color: #ffffff;
}

.m-c1 {
  width: 200rpx;
  background: #f4f8fb;
}

.m-c2 {
  flex: 1;
  min-width: 0;
}

.cont {
  border-left: none;
  color: transparent;
}
