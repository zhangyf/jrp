<view class="wrap">
  <view class="head">
    <text class="count">共 {{items.length}} 句</text>
    <text class="link" bindtap="load">刷新</text>
  </view>

  <view class="err" wx:if="{{err}}">{{err}}</view>
  <view class="empty" wx:if="{{!loading && !err && items.length === 0}}">今天没有造句任务。</view>

  <view class="note-ok" wx:if="{{readOnly}}">体验版：这 {{items.length}} 句是固定的示范题，可以写、可以「对答案」，但不保存进度。</view>

  <view class="card item {{item.graded ? (item.correct ? 'right' : 'wrong') : ''}}"
        wx:for="{{items}}" wx:key="number">
    <view class="q">
      <text class="num">{{item.number}}</text>
      <text class="cn">{{item.chinese}}</text>
    </view>

    <!-- ⚠️ 不用 auto-height：textarea 是原生组件，auto-height 首帧按默认尺寸渲染，
         等异步测量完才缩回去 —— 老师看到的「刚进去特别宽、几秒后恢复」就是它。
         固定高度，首帧就是最终尺寸。 -->
    <textarea class="answer"
              placeholder="写日语整句"
              value="{{item.input}}"
              disabled="{{item.graded}}"
              data-index="{{index}}"
              bindinput="onInput" />

    <view class="flag" wx:if="{{item.graded}}">{{item.correct ? '✓ 对' : '✗ 错'}}</view>
    <view class="reason" wx:if="{{item.graded && item.reason}}">{{item.reason}}</view>
    <view class="reveal" wx:if="{{item.graded && !item.correct}}">课本原文：{{item.answer}}</view>
  </view>

  <!-- 语法知识卡：两张表（助词用法 / 词语修饰），默认收起、点标题展开，
       放题目下面不挡练习。内容与 web 造句页同一份，改要两处同步。 -->
  <view class="grammar">
    <view class="g-head" bindtap="toggleGrammar">
      <text class="g-title">语法知识（助词用法 · 词语修饰）</text>
      <text class="g-arrow">{{grammarOpen ? '收起 ▴' : '展开 ▾'}}</text>
    </view>
    <view class="g-body" wx:if="{{grammarOpen}}">
      <view class="g-sec">① 助词的用法</view>
      <view class="p-row" wx:for="{{particles}}" wx:for-item="r" wx:key="p">
        <text class="p-word">{{r.p}}</text>
        <view class="p-main">
          <text class="p-uses">{{r.uses}}</text>
          <text class="p-ex" wx:for="{{r.ex}}" wx:for-item="e" wx:key="*this">{{e}}</text>
        </view>
      </view>

      <view class="g-sec">② 词语的修饰（名词 · 动词 · 形容词互接）</view>
      <view class="m-tr m-th">
        <text class="m-c0">词类</text>
        <text class="m-c1">接续</text>
        <text class="m-c2">例</text>
      </view>
      <view class="m-tr" wx:for="{{modify}}" wx:for-item="r" wx:key="k">
        <text class="m-c0 {{r.contC ? 'cont' : ''}}">{{r.cls}}</text>
        <text class="m-c1">{{r.joint}}</text>
        <text class="m-c2">{{r.ex}}</text>
      </view>
    </view>
  </view>

  <view class="bar" wx:if="{{items.length}}">
    <button class="btn ghost" bindtap="grade" loading="{{grading}}">对答案</button>
    <!-- 体验版不给「提交」：/api/record 不在白名单里，点了只会 403 -->
    <button class="btn primary" wx:if="{{!readOnly}}" bindtap="submit" loading="{{submitting}}">提交</button>
  </view>

  <view class="tip" wx:if="{{items.length && readOnly}}">
    想记录进度、练自己的句库，回到首页退出试用、用微信登录。
  </view>
</view>
